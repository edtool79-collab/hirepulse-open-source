            "title": "Top keywords per domain",
            "type": "integer",
            "description": "How many of the domain's ranking keywords to return (organic top 20 positions, highest search volume first). 0 = skip this lookup. Each returned keyword is one charged result. Default 20, maximum 1000. For a cheap agent check use top_keywords=0 and competitors=0 to request only the overview, without the keyword and competitor lookups.",
            "default": 20,
            "minimum": 0,
            "maximum": 1000
        },
