        "language": {
            "title": "Language",
            "type": "string",
            "description": "Two-letter language code. Leave empty to use the main language of the country. Countries with more than one language: US: en/es; CA: en/fr; IN: en/hi; DZ: fr/ar; BE: fr/nl/de; CY: el/en; EG: ar/en; GR: el/en; HK: en/zh-TW; ID: en/id; IL: he/ar; MY: en/ms; MA: ar/fr; PK: en/ur; PH: en/tl; SG: en/zh-CN; CH: de/fr/it; UA: uk/ru; AE: ar/en; VN: en/vi.",
            "editor": "textfield"
        },
        "max_results": {
            "title": "Max results",
            "type": "integer",
            "description": "Only for \"ideas\" and \"suggestions\": maximum number of keywords to return (per seed in \"suggestions\" mode). Each returned keyword with metrics is one charged result. Default 50, maximum 1000.",
            "default": 50,
            "minimum": 1,
            "maximum": 1000
        },
        "min_search_volume": {
            "title": "Minimum monthly search volume",
            "type": "integer",
            "description": "Return only keywords with at least this many monthly searches. Keywords below the threshold are not returned and not charged. 0 = no minimum.",
            "default": 0,
            "minimum": 0
        },
        "include_monthly_searches": {
            "title": "Include 12-month history",
            "type": "boolean",
            "description": "Add a \"monthly_searches\" array with the search volume of each of the last 12 months to every keyword. Off by default to keep the output small.",
            "default": false
        },
        "include_ai_search_volume": {
            "title": "Include AI search volume",
            "type": "boolean",
            "description": "Also return \"ai_search_volume\": an estimate of how often each keyword is used in AI assistants per month. This is one extra lookup per batch, plus one result charge for every keyword that has AI data. If the data is not available for the selected country, the field stays null and nothing extra is charged.",
            "default": false
        }
    },
    "required": [
        "keywords"
    ]
}
