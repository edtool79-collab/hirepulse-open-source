{
    "title": "Keyword Search Volume & Ideas input",
    "description": "Get Google search volume, CPC, competition, keyword difficulty and search intent for keywords, or discover new keyword ideas from seed keywords.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "keywords": {
            "title": "Keywords",
            "type": "array",
            "description": "In \"metrics\" mode: the exact keywords to measure (up to 5,000). In \"ideas\" mode: seed keywords describing a topic (up to 200). In \"suggestions\" mode: seed phrases to expand into long-tail keywords (up to 20). Each keyword: max 80 characters and 10 words.",
            "editor": "stringList",
            "prefill": [
                "keyword research tool",
                "ai agents",
                "web scraping api"
            ],
            "minItems": 1,
            "maxItems": 5000,
            "uniqueItems": true
        },
        "mode": {
            "title": "Mode",
            "type": "string",
            "description": "\"metrics\": return metrics for exactly the keywords given (one lookup per 700 keywords). \"ideas\": return keywords related to the seed keywords as a group, most relevant first (one lookup). \"suggestions\": return long-tail keywords that contain each seed phrase, highest search volume first (one lookup per seed).",
            "editor": "select",
            "default": "metrics",
            "enum": [
                "metrics",
                "ideas",
                "suggestions"
            ],
            "enumTitles": [
                "Metrics for my keywords",
                "Keyword ideas (related to my seeds)",
                "Keyword suggestions (long-tail, contain my seed)"
            ]
        },
        "country": {
            "title": "Country",
            "type": "string",
            "description": "Country whose Google search data is used, as a two-letter ISO code. Default: US.",
