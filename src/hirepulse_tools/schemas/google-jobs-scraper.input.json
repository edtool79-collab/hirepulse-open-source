        "location": {
            "title": "City or region (optional)",
            "type": "string",
            "description": "Narrow the search to a city or region inside the country, written as \"City,Region\", for example \"Austin,Texas\" or \"London,England\". Leave empty to search the whole country.",
            "editor": "textfield"
        },
        "radius_km": {
            "title": "Radius around the city (km)",
            "type": "integer",
            "description": "Only with a city: search up to this distance from it. 1 to 300. Leave empty for the city's default area.",
            "minimum": 1,
            "maximum": 300
        },
        "max_jobs_per_query": {
            "title": "Maximum jobs per search",
            "type": "integer",
            "description": "How many jobs to return for each search, at most 200. Each returned job is one charged result. Default 50.",
            "default": 50,
            "minimum": 1,
            "maximum": 200
        },
        "employment_types": {
            "title": "Employment types (optional)",
            "type": "array",
            "description": "Only return these contract types. Leave empty for all. For part-time jobs use the literal \"partime\". This spelling is required by the Actor code; \"parttime\" is not accepted.",
            "editor": "select",
            "items": {
                "type": "string",
                "enum": [
                    "fulltime",
                    "partime",
                    "contractor",
                    "intern"
                ],
                "enumTitles": [
                    "Full-time",
                    "Part-time",
                    "Contractor",
                    "Internship"
                ]
            }
        },
        "include_descriptions": {
            "title": "Add full job descriptions",
            "type": "boolean",
            "description": "Fetch the full description text for jobs whose apply link is on a company job board (Workday, Greenhouse, Lever, Ashby). Other jobs keep the link only. No extra charge. Default on.",
            "default": true
        },
        "language": {
            "title": "Language",
            "type": "string",
            "description": "Two-letter language code. Language of the job search. Leave empty to use the main language of the country. Countries with more than one language: US: en/es; CA: en/fr; IN: en/hi; DZ: fr/ar; BE: fr/nl/de; CY: el/en; EG: ar/en; GR: el/en; HK: en/zh-TW; ID: en/id; IL: he/ar; MY: en/ms; MA: ar/fr; PK: en/ur; PH: en/tl; SG: en/zh-CN; CH: de/fr/it; UA: uk/ru; AE: ar/en; VN: en/vi.",
            "editor": "textfield"
        }
    },
    "required": [
        "queries"
    ]
}