{
    "title": "Google Jobs Scraper input",
    "description": "Search Google's job listings (Google Jobs) for any job title or keyword, in any supported country or city. Returns title, company, location, salary, contract type, posting date and the link to apply.",
    "type": "object",
    "schemaVersion": 1,
    "properties": {
        "queries": {
            "title": "Job searches",
            "type": "array",
            "description": "Array of strings. In the Console UI: one per line. What to search for, as you would type it in Google, for example \"data engineer\" or \"nurse night shift\". Up to 50 per run.",
            "editor": "stringList",
            "prefill": [
                "data engineer"
            ],
            "minItems": 1,
            "maxItems": 50
        },
        "country": {
